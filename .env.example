# Environment Variables for Coolify V4 Deployment

# ----------------------------------------------------------------------
# 1. Database Variables (Coolify Managed)
# ----------------------------------------------------------------------
# DATABASE_URL: Full connection URL for the PostgreSQL database.
# Coolify will generate and inject this variable if you create a DB resource.
# Example: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://agno_user:YOUR_STRONG_PASSWORD@your_db_host:5432/agno_db"

# ----------------------------------------------------------------------
# 2. Agno AgentOS Variables (Backend)
# ----------------------------------------------------------------------
# API keys for LLM models. Coolify will inject these variables
# if configured in the Coolify interface.
# OPENAI_API_KEY="YOUR_OPENAI_KEY"
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_KEY"
# GOOGLE_API_KEY="YOUR_GOOGLE_KEY"

# ----------------------------------------------------------------------
# 3. Agno Agent UI Variables (Frontend)
# ----------------------------------------------------------------------
# Full URL of the deployed AgentOS (Backend).
# Example: https://agno.myproject.com
NEXT_PUBLIC_AGENTOS_URL="https://YOUR_AGENTOS_DOMAIN"

# ----------------------------------------------------------------------
# 4. Ollama Variables (Local LLM)
# ----------------------------------------------------------------------
# Connection URL for the Ollama server for local LLM models.
OLLAMA_URL=http://ollama:11434

# ----------------------------------------------------------------------
# 5. Optimization Variables (Optional)
# ----------------------------------------------------------------------
# For Observability with Langfuse (Recommended for Production)
# LANGFUSE_SECRET_KEY="YOUR_LANGFUSE_SECRET_KEY"
# LANGFUSE_PUBLIC_KEY="YOUR_LANGFUSE_PUBLIC_KEY"
# LANGFUSE_HOST="https://cloud.langfuse.com"
